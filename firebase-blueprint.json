{
  "entities": {
    "Pilgrim": {
      "title": "Pilgrim",
      "description": "Information about a pilgrim registered for Hajj or Umrah. Media attachments are stored strictly as external/Cloudinary URLs rather than binary blobs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "termsAccepted": { "type": "string", "enum": ["نعم", "لا"] },
        "firstName": { "type": "string", "maxLength": 100 },
        "secondName": { "type": "string", "maxLength": 100 },
        "thirdName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "englishFullName": { "type": "string", "maxLength": 200 },
        "gender": { "type": "string", "enum": ["ذكر", "أنثى"] },
        "nationality": { "type": "string", "maxLength": 100 },
        "nationalId": { "type": "string", "minLength": 10, "maxLength": 10 },
        "idIssueDate": { "type": "string", "format": "date" },
        "idIssueDateHijri": { "type": "string", "maxLength": 20 },
        "idExpiryDate": { "type": "string", "format": "date" },
        "idExpiryDateHijri": { "type": "string", "maxLength": 20 },
        "birthDate": { "type": "string", "format": "date" },
        "birthDateHijri": { "type": "string", "maxLength": 20 },
        "mobile": { "type": "string", "pattern": "^05[0-9]{8}$" },
        "whatsapp": { "type": "string", "pattern": "^05[0-9]{8}$" },
        "email": { "type": "string", "format": "email" },
        "bankAccountName": { "type": "string", "maxLength": 200 },
        "iban": { "type": "string", "maxLength": 50 },
        "bankName": { "type": "string", "maxLength": 100 },
        "transport": { "type": "string", "enum": ["باص", "طائرة"] },
        "hajjType": { "type": "string", "enum": ["مستحب", "تمتع", "قِران", "إفراد", "عمرة", "حجة الإسلام الواجبة (أول مرة)", "احتياط", "نيابة", "امتثالاً للأمر الواقع"] },
        "lastHajjYear": { "type": "string", "maxLength": 30 },
        "currentMarji": { "type": "string", "maxLength": 150 },
        "customMarji": { "type": "string", "maxLength": 150 },
        "previousMarji": { "type": "string", "maxLength": 150 },
        "madinahPrivateRoomRequested": { "type": "boolean" },
        "madinahPrivateRoomNote": { "type": "string", "maxLength": 400 },
        "hasMahram": { "type": "boolean" },
        "mahramDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "maxLength": 200 },
              "nationalId": { "type": "string", "maxLength": 20 },
              "relation": { "type": "string", "maxLength": 100 }
            }
          }
        },
        "mobilityIndependence": { "type": "string", "enum": ["نعم", "لا"] },
        "status": { "type": "string", "enum": ["قيد المراجعة", "تم القبول", "مكتمل", "مقبول ومؤكد", "مكتمل الدفع", "معتذر", "مرفوض", "محذوف"] },
        "applicationStatus": { "type": "string", "enum": ["قيد المراجعة", "تم القبول", "مكتمل"] },
        "documentsReceived": { "type": "boolean" },
        "paymentReceived": { "type": "boolean" },
        "statusNotes": { "type": "string", "maxLength": 500 },
        "roomNumber": { "type": "string", "maxLength": 100 },
        "roomNumberMakkah": { "type": "string", "maxLength": 100 },
        "roomNumberMadinah": { "type": "string", "maxLength": 100 },
        "roomNumberMina": { "type": "string", "maxLength": 100 },
        "busNumber": { "type": "string", "maxLength": 100 },
        "busSeat": { "type": "string", "maxLength": 100 },
        "flightNumberOutbound": { "type": "string", "maxLength": 200 },
        "flightNumberReturn": { "type": "string", "maxLength": 200 },
        "flightTicketNumber": { "type": "string", "maxLength": 100 },
        "selectedPackage": { "type": "string", "maxLength": 200 },
        "registrationReference": { "type": "string", "maxLength": 20 },
        "nationalIdImage": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "External or Cloudinary URL for the National ID image"
        },
        "paymentReportedByPilgrim": { "type": "boolean" },
        "paymentReportedDate": { "type": "string", "maxLength": 20 },
        "paymentReportedDateHijri": { "type": "string", "maxLength": 20 },
        "paymentReportedAt": { "type": "string", "maxLength": 40 },
        "paymentApprovedByAdmin": { "type": "boolean" },
        "paymentApprovedBy": { "type": "string", "maxLength": 150 },
        "paymentApprovedAt": { "type": "string", "maxLength": 40 },
        "vaccinationCompleted": { "type": "boolean" },
        "vaccinationDate": { "type": "string", "maxLength": 20 },
        "vaccinationDateHijri": { "type": "string", "maxLength": 20 },
        "vaccinationReportedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "createdAt", "firstName", "lastName", "nationalId", "mobile", "registrationReference"]
    },
    "HajjPackage": {
      "title": "Hajj Package",
      "description": "Details of a Hajj or Umrah package offered by the campaign. Uses external/Cloudinary image URLs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 100 },
        "price": { "type": "string", "maxLength": 50 },
        "transport": { "type": "string", "maxLength": 200 },
        "accommodationMakkah": { "type": "string", "maxLength": 500 },
        "accommodationMadinah": { "type": "string", "maxLength": 500 },
        "campMina": { "type": "string", "maxLength": 500 },
        "features": { "type": "array", "items": { "type": "string" } },
        "image": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "External or Cloudinary URL for the package cover image"
        },
        "seasonId": { "type": "string", "maxLength": 128 },
        "seasonYear": { "type": "string", "maxLength": 10 },
        "mediaAssetId": { "type": "string", "maxLength": 128 },
        "showOnHomepage": { "type": "boolean" },
        "maxCapacity": { "type": "number" },
        "registrationDeadline": { "type": "string", "maxLength": 64 },
        "forceClose": { "type": "boolean" },
        "forceCloseReason": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "title", "price"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Important updates, lessons, and announcements for pilgrims. Stores only external/Cloudinary URLs for images and videos instead of binary blobs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "format": "date" },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "enum": ["هام", "توجيهات", "مواعيد"] },
        "fontSize": { "type": "string", "enum": ["sm", "normal", "lg", "xl", "2xl"] },
        "isBold": { "type": "boolean" },
        "textAlign": { "type": "string", "enum": ["right", "center", "justify"] },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "External or Cloudinary URL (https://...) for the attached image"
        },
        "videoUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "External, Cloudinary, or YouTube URL (https://...) for the attached video"
        },
        "mediaProvider": {
          "type": "string",
          "enum": ["cloudinary", "external", "youtube"],
          "description": "External media hosting provider used for the announcement URLs"
        },
        "displaySettings": {
          "type": "object",
          "properties": {
            "showImage": { "type": "boolean" },
            "showVideo": { "type": "boolean" },
            "enableLightbox": { "type": "boolean" },
            "highlightCard": { "type": "boolean" }
          }
        },
        "seasonId": { "type": "string", "maxLength": 128 },
        "seasonYear": { "type": "string", "maxLength": 10 },
        "imageAssetId": { "type": "string", "maxLength": 128 },
        "videoAssetId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "title", "content", "category"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Campaign staff and Super Admin owner with RBAC permissions, PBKDF2 password hashes, mandatory 2FA (TOTP), and instant session revocation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "pin": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "isSuperAdminOwner": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "passwordChangedAt": { "type": "string" },
        "totpEnabled": { "type": "boolean" },
        "totpSecret": { "type": "string", "maxLength": 128 },
        "totpConfiguredAt": { "type": "string" },
        "totpResetAt": { "type": "string" },
        "totpResetBy": { "type": "string", "maxLength": 150 },
        "lastLoginAt": { "type": "string" },
        "suspendedAt": { "type": "string" },
        "suspendedBy": { "type": "string", "maxLength": 150 },
        "sessionVersion": { "type": "number" },
        "permissions": {
          "type": "object",
          "properties": {
            "managePilgrims": { "type": "boolean" },
            "manageAnnouncements": { "type": "boolean" },
            "managePackages": { "type": "boolean" },
            "manageStaff": { "type": "boolean" },
            "manageFinance": { "type": "boolean" },
            "manageReligiousGuide": { "type": "boolean" },
            "manageTravelKit": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "role"]
    },
    "AuthLockout": {
      "title": "Authentication Lockout",
      "description": "Brute-force protection lockout tracker blocking an account for 15 minutes after 5 consecutive failed password or 2FA attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "identifier": { "type": "string", "maxLength": 200 },
        "failedAttempts": { "type": "number" },
        "lockedUntil": { "type": "number" },
        "lastFailedAt": { "type": "number" },
        "reason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "identifier", "failedAttempts", "lockedUntil"]
    },
    "TrustedDevice": {
      "title": "Trusted Device",
      "description": "Verified trusted device bound to an admin/staff user with SHA-256 device token hash, device fingerprint, and optional WebAuthn biometric credential ID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 200 },
        "deviceName": { "type": "string", "maxLength": 200 },
        "deviceType": { "type": "string", "enum": ["desktop", "mobile", "tablet"] },
        "browserName": { "type": "string", "maxLength": 100 },
        "osName": { "type": "string", "maxLength": 100 },
        "deviceTokenHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "deviceFingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
        "trustedAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" },
        "biometricEnabled": { "type": "boolean" },
        "biometricCredentialId": { "type": "string", "maxLength": 512 },
        "biometricPublicKeySpki": { "type": "string", "maxLength": 1024 },
        "biometricEnabledAt": { "type": "string" },
        "biometricLabel": { "type": "string", "maxLength": 200 },
        "revoked": { "type": "boolean" }
      },
      "required": ["id", "userId", "deviceName", "deviceTokenHash", "deviceFingerprint", "trustedAt", "biometricEnabled"]
    },
    "CampaignSettings": {
      "title": "Campaign Settings",
      "description": "Global configuration, external media provider settings (Cloudinary), and texts for the campaign website",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "marjiList": { "type": "array", "items": { "type": "string" } },
        "approvedBanks": {
          "type": "array",
          "description": "Admin-managed list of approved banks visible in the pilgrim registration form",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string", "maxLength": 120 },
              "isActive": { "type": "boolean" }
            }
          }
        },
        "busList": { "type": "array", "items": { "type": "string" } },
        "groupLocations": {
          "type": "object",
          "description": "Map of assigned group names (buses, flights, Mina camps) to current latitude/longitude coordinates configured by admins"
        },
        "siteTexts": { "type": "object" },
        "hajjDaysTimeline": { "type": "array" },
        "ritualAudioGuides": {
          "type": "array",
          "description": "Short supervisor-uploaded audio explanations for Hajj and Umrah rituals rendered in دليل المناسك (metadata + storage URLs only, zero base64)"
        },
        "cloudinaryConfig": {
          "type": "object",
          "description": "Configuration for uploading images and videos to Cloudinary CDN instead of database blobs",
          "properties": {
            "cloudName": { "type": "string", "maxLength": 120 },
            "uploadPreset": { "type": "string", "maxLength": 120 }
          }
        },
        "youtubeConfig": {
          "type": "object",
          "description": "Configuration for displaying latest YouTube channel video and live stream on the website",
          "properties": {
            "enabled": { "type": "boolean" },
            "channelUrl": { "type": "string", "maxLength": 500 },
            "channelId": { "type": "string", "maxLength": 100 },
            "channelHandle": { "type": "string", "maxLength": 100 },
            "isLiveActive": { "type": "boolean" },
            "liveStreamUrl": { "type": "string", "maxLength": 500 },
            "liveTitle": { "type": "string", "maxLength": 300 },
            "cachedLatestVideoId": { "type": "string", "maxLength": 60 },
            "cachedLatestVideoTitle": { "type": "string", "maxLength": 300 },
            "cachedLatestVideoDate": { "type": "string", "maxLength": 60 }
          }
        },
        "advisorConfig": {
          "type": "object",
          "description": "Configuration for مرشد القائم الذكي official RAG advisor",
          "properties": {
            "enabled": { "type": "boolean" },
            "advisorName": { "type": "string", "maxLength": 120 },
            "welcomeMessage": { "type": "string", "maxLength": 1000 },
            "unavailableMessage": { "type": "string", "maxLength": 1000 },
            "model": { "type": "string", "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"] },
            "creativityLevel": { "type": "string", "enum": ["strict", "balanced", "detailed"] },
            "responseLength": { "type": "string", "enum": ["short", "medium", "detailed"] },
            "maxMessagesPerHour": { "type": "number" },
            "maxQuestionLength": { "type": "number" },
            "enabledPageSources": { "type": "object" },
            "disabledPageIds": { "type": "array", "items": { "type": "string" } },
            "updatedAt": { "type": "string" },
            "updatedBy": { "type": "string", "maxLength": 150 }
          }
        }
      }
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Audit trail of admin actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminId", "action", "timestamp"]
    },
    "PilgrimFeedback": {
      "title": "Pilgrim Feedback",
      "description": "Feedback provided by pilgrims after their trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pilgrimId": { "type": "string" },
        "pilgrimName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["التنظيم", "السكن", "الإعاشة", "الإرشاد الديني", "المواصلات", "عام"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pilgrimId", "rating", "category", "createdAt"]
    },
    "NotificationItem": {
      "title": "Notification Item",
      "description": "Administrative broadcast or targeted notification for pilgrims with scheduling and delivery statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 3000 },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal"] },
        "targetType": { "type": "string", "enum": ["all", "transport", "package", "bus", "gender", "individual"] },
        "targetValue": { "type": "string", "maxLength": 200 },
        "deliveryType": { "type": "string", "enum": ["instant", "scheduled"] },
        "scheduledAt": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "scheduled", "sent", "cancelled"] },
        "createdBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "sentAt": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "targetCount": { "type": "number" },
            "sentCount": { "type": "number" },
            "readCount": { "type": "number" },
            "failureCount": { "type": "number" }
          }
        }
      },
      "required": ["id", "title", "body", "priority", "targetType", "deliveryType", "status", "createdAt"]
    },
    "PilgrimNotification": {
      "title": "Pilgrim Notification",
      "description": "Recipient-specific inbox record linking a notification to an individual pilgrim with read receipt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notificationId": { "type": "string" },
        "pilgrimId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 3000 },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal"] },
        "isRead": { "type": "boolean" },
        "readAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "notificationId", "pilgrimId", "title", "body", "priority", "isRead", "createdAt"]
    },
    "ReligiousGuide": {
      "title": "Religious Guide",
      "description": "Profile and assignments of a religious guide in the campaign, linked to assigned pilgrims in the database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "specialization": { "type": "string", "maxLength": 200 },
        "languages": { "type": "array", "items": { "type": "string" } },
        "assignedCampaigns": { "type": "array", "items": { "type": "string" } },
        "assignedGroups": { "type": "array", "items": { "type": "string" } },
        "assignedPilgrimIds": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["نشط", "في مهمة ميدانية", "إجازة"] }
      },
      "required": ["id", "name", "phone", "specialization"]
    },
    "AwarenessProgram": {
      "title": "Awareness Program",
      "description": "Pre-Hajj, During-Hajj, or Post-Hajj religious awareness program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "phase": { "type": "string", "enum": ["قبل الحج", "أثناء الحج", "بعد الحج"] },
        "topicCategory": { "type": "string", "maxLength": 150 },
        "hajjStage": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "targetType": { "type": "string", "enum": ["all", "package", "bus", "flight"] },
        "targetValue": { "type": "string", "maxLength": 200 },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "phase", "topicCategory"]
    },
    "ReligiousLesson": {
      "title": "Religious Lesson",
      "description": "Scheduled or completed religious lecture, lesson, or field session with unique QR code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "category": { "type": "string", "maxLength": 150 },
        "phase": { "type": "string", "enum": ["قبل الحج", "أثناء الحج", "بعد الحج"] },
        "guideId": { "type": "string" },
        "guideName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["مسودة", "مجدول", "جارٍ", "مكتمل", "ملغى"] },
        "qrCodeToken": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "title", "category", "date", "status", "qrCodeToken"]
    },
    "LessonAttendanceRecord": {
      "title": "Lesson Attendance Record",
      "description": "Pilgrim attendance record for a specific religious lesson via QR or manual verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lessonId": { "type": "string" },
        "pilgrimId": { "type": "string" },
        "nationalId": { "type": "string" },
        "pilgrimName": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["حاضر", "غائب", "مستأذن"] },
        "method": { "type": "string", "enum": ["QR", "يدوي", "استيراد"] },
        "approvedBy": { "type": "string", "maxLength": 150 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "lessonId", "pilgrimId", "status", "method", "timestamp"]
    },
    "ShariaInquiry": {
      "title": "Sharia Inquiry",
      "description": "Religious question submitted by a pilgrim with specialist answer and official approval status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pilgrimId": { "type": "string" },
        "pilgrimName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 150 },
        "question": { "type": "string", "maxLength": 3000 },
        "answer": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["جديد", "قيد الإجابة", "بانتظار الاعتماد", "معتمد ومنشور", "مؤرشف"] },
        "isApproved": { "type": "boolean" },
        "approvedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "pilgrimId", "category", "question", "status"]
    },
    "FiqhSection": {
      "title": "Fiqh Section",
      "description": "Dynamic jurisprudence section/chapter (أبواب المسائل الفقهية) with custom ordering, visibility toggle, and ID-based linking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "originalDefaultName": { "type": "string", "maxLength": 200 },
        "order": { "type": "number" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "order", "isVisible"]
    },
    "MediaAsset": {
      "title": "Media Asset",
      "description": "Metadata registry for deduplicated compressed images (WebP) and videos stored externally or in Storage, never storing binary payloads in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fileHash": { "type": "string", "maxLength": 128 },
        "kind": { "type": "string", "enum": ["image", "video"] },
        "url": { "type": "string", "maxLength": 2048 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "storagePath": { "type": "string", "maxLength": 512 },
        "provider": { "type": "string", "enum": ["firebase_storage", "cloudinary", "server_cdn", "external"] },
        "fileName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "format": { "type": "string", "enum": ["webp", "jpeg", "avif", "mp4", "webm"] },
        "originalSizeBytes": { "type": "number" },
        "compressedSizeBytes": { "type": "number" },
        "savingsPercent": { "type": "number" },
        "uploadedAt": { "type": "string" },
        "uploadPolicy": {
          "type": "string",
          "enum": ["new_file", "reused_existing", "new_seasonal_copy", "modified_version"]
        },
        "version": { "type": "number" },
        "parentAssetId": { "type": "string", "maxLength": 128 },
        "linkedSeasonIds": { "type": "array", "items": { "type": "string" } },
        "linkedRecordIds": { "type": "array", "items": { "type": "string" } },
        "seasonLinksHistory": { "type": "array" },
        "retentionPolicy": {
          "type": "object",
          "properties": {
            "preserveInArchive": { "type": "boolean" },
            "status": { "type": "string", "enum": ["active", "archived_protected", "pending_cleanup"] },
            "lastReferencedAt": { "type": "string" },
            "unlinkedAt": { "type": "string" },
            "retentionMinDays": { "type": "number" }
          }
        }
      },
      "required": ["id", "fileHash", "kind", "url", "mimeType"]
    },
    "HajjSeason": {
      "title": "Hajj Season",
      "description": "Independent annual Hajj or Umrah season with status lifecycle, retention policy, linked packages, announcements, pilgrims, and media assets.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "hijriYear": { "type": "string", "maxLength": 10 },
        "name": { "type": "string", "maxLength": 200 },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "protectArchivedMedia": { "type": "boolean" },
        "retentionDays": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "linkedPackageIds": { "type": "array", "items": { "type": "string" } },
        "linkedAnnouncementIds": { "type": "array", "items": { "type": "string" } },
        "linkedPilgrimIds": { "type": "array", "items": { "type": "string" } },
        "linkedMediaAssetIds": { "type": "array", "items": { "type": "string" } },
        "history": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "hijriYear", "name", "status"]
    },
    "CulturalProgram": {
      "title": "Cultural Program",
      "description": "Cultural supervision events, seminars, and lectures synced across all supervisors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 200 },
        "attendeesCount": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "type"]
    },
    "SystemMeta": {
      "title": "System Metadata",
      "description": "One-time initialization guard preventing default seed data from overwriting live data",
      "type": "object",
      "properties": {
        "isSeeded": { "type": "boolean" },
        "seededAt": { "type": "string" },
        "schemaVersion": { "type": "number" }
      },
      "required": ["isSeeded"]
    },
    "AdvisorKnowledgeItem": {
      "title": "Advisor Knowledge Item",
      "description": "Admin-curated and strictly classified knowledge document for مرشد القائم الذكي RAG retrieval",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 15000 },
        "summary": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 120 },
        "sourceType": { "type": "string", "maxLength": 60 },
        "sourceUrl": { "type": "string", "maxLength": 300 },
        "classification": { "type": "string", "enum": ["Public", "Approved", "Admin Only", "Confidential"] },
        "isApprovedForAdvisor": { "type": "boolean" },
        "isPublicVisible": { "type": "boolean" },
        "disabledInAdvisor": { "type": "boolean" },
        "approvedBy": { "type": "string", "maxLength": 150 },
        "approvedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "classification", "isApprovedForAdvisor", "isPublicVisible"]
    },
    "AdvisorInquiryLog": {
      "title": "Advisor Inquiry Log",
      "description": "Audit log of questions asked to مرشد القائم الذكي and retrieval status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 1200 },
        "answer": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["answered", "unavailable", "blocked_security", "error"] },
        "matchedSources": { "type": "array" },
        "modelUsed": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "question", "answer", "status", "createdAt"]
    },
    "ManasikStage": {
      "title": "Manasik Stage",
      "description": "Dynamic Hajj Manasik stage/day with ordered rituals, legal rulings, explanations/duas, caravan notes, and activation status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "summary": { "type": "string", "maxLength": 2000 },
        "campaignTip": { "type": "string", "maxLength": 1500 },
        "order": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "rituals": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "title", "order", "isEnabled", "rituals"]
    },
    "PilgrimManasikProgress": {
      "title": "Pilgrim Manasik Progress",
      "description": "Cloud-persisted personal Manasik checklist progress tied exclusively to an individual registered pilgrim",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pilgrimId": { "type": "string", "maxLength": 128 },
        "nationalId": { "type": "string", "maxLength": 30 },
        "completedRitualIds": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "nationalId", "completedRitualIds"]
    }
  },
  "firestore": {
    "pilgrims/{pilgrimId}": {
      "schema": "Pilgrim",
      "description": "Collection of registered pilgrims"
    },
    "packages/{packageId}": {
      "schema": "HajjPackage",
      "description": "Collection of Hajj/Umrah packages"
    },
    "announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Collection of announcements with external/Cloudinary media URLs"
    },
    "adminUsers/{adminUserId}": {
      "schema": "AdminUser",
      "description": "Collection of administrative users"
    },
    "settings/campaign": {
      "schema": "CampaignSettings",
      "description": "Global campaign settings document"
    },
    "settings/systemMeta": {
      "schema": "SystemMeta",
      "description": "Database initialization guard flag"
    },
    "activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit logs of administrative actions"
    },
    "feedback/{feedbackId}": {
      "schema": "PilgrimFeedback",
      "description": "Collection of post-trip pilgrim feedback"
    },
    "notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Central repository of administrative notifications and broadcasts"
    },
    "pilgrim_notifications/{id}": {
      "schema": "PilgrimNotification",
      "description": "Individual recipient inboxes for pilgrims with read state tracking"
    },
    "religious_guides/{guideId}": {
      "schema": "ReligiousGuide",
      "description": "Religious guides profiles, schedules, and performance evaluations"
    },
    "religious_programs/{programId}": {
      "schema": "AwarenessProgram",
      "description": "Pre-Hajj, During-Hajj, and Post-Hajj educational programs"
    },
    "religious_lessons/{lessonId}": {
      "schema": "ReligiousLesson",
      "description": "Scheduled and completed religious lessons and lectures"
    },
    "religious_attendance/{attendanceId}": {
      "schema": "LessonAttendanceRecord",
      "description": "QR and manual attendance records for religious lessons"
    },
    "religious_inquiries/{inquiryId}": {
      "schema": "ShariaInquiry",
      "description": "Sharia inquiries, specialist answers, and approval workflow"
    },
    "religious_fiqh_sections/{sectionId}": {
      "schema": "FiqhSection",
      "description": "Dynamic jurisprudence sections (أبواب المسائل الفقهية) with order and visibility state"
    },
    "mediaAssets/{assetId}": {
      "schema": "MediaAsset",
      "description": "Season-aware SHA-256 deduplicated WebP/video media asset metadata registry"
    },
    "seasons/{seasonId}": {
      "schema": "HajjSeason",
      "description": "Annual Hajj/Umrah seasons registry with independent record associations and media archive retention policy"
    },
    "cultural_programs/{programId}": {
      "schema": "CulturalProgram",
      "description": "Cultural supervision programs and events"
    },
    "advisor_knowledge/{itemId}": {
      "schema": "AdvisorKnowledgeItem",
      "description": "Admin-approved knowledge items and classifications for مرشد القائم الذكي"
    },
    "advisor_inquiries/{inquiryId}": {
      "schema": "AdvisorInquiryLog",
      "description": "Question & grounded response logs for مرشد القائم الذكي"
    },
    "manasik_stages/{stageId}": {
      "schema": "ManasikStage",
      "description": "Dynamic Hajj Manasik stages and interactive checklist rituals managed by religious guidance admins"
    },
    "pilgrim_manasik_progress/{pilgrimKey}": {
      "schema": "PilgrimManasikProgress",
      "description": "Per-pilgrim cloud-synced Manasik completion records linked by unique National ID / Pilgrim ID"
    },
    "registration_forms/{formId}": {
      "schema": "DynamicFormTemplate",
      "description": "Admin-managed dynamic registration form templates linked to Hajj/Umrah packages with versioned schema snapshots"
    },
    "auth_lockouts/{lockoutId}": {
      "schema": "AuthLockout",
      "description": "Brute-force protection lockout records (15-minute lock after 5 consecutive failed auth/2FA attempts)"
    },
    "trusted_devices/{deviceId}": {
      "schema": "TrustedDevice",
      "description": "Cryptographically verified trusted devices per admin/staff account with optional WebAuthn biometric binding"
    }
  }
}
